{
  "id": "pick_and_roll",
  "name": "Pick & Roll (with Defensive Switch)",
  "category": "offense",
  "description": "Classic high pick-and-roll: the 5 sets a ball-screen for the 1, the defense reacts with a switch (X1 takes 5, X5 takes 1).",
  "coaching": [
    "1. Spacing: 2, 3, 4 are spread to the corners and weak-side wing to keep helpers honest.",
    "2. The 5 sprints into a high screen on X1's top shoulder.",
    "3. The 1 dribbles tight off the screen, attacking the gap.",
    "4. Defense calls SWITCH: X5 hedges out onto the ball, X1 picks up the rolling 5.",
    "5. The 5 rolls hard to the rim. If X1 cannot beat him to the spot it is an easy lob."
  ],
  "players": [
    { "id": "o1", "team": "offense", "role": "PG", "label": "1", "start": { "x": 25, "y": 30 } },
    { "id": "o2", "team": "offense", "role": "SG", "label": "2", "start": { "x": 4,  "y": 6  } },
    { "id": "o3", "team": "offense", "role": "SF", "label": "3", "start": { "x": 46, "y": 6  } },
